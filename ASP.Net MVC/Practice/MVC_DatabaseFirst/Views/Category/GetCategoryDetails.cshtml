@model IEnumerable<MVC_DatabaseFirst.Models.Customer2>
@{
    ViewBag.Title = "GetCategoryDetails";
}

<h2>GetCategoryDetails</h2>
@foreach(var item in Model)
            {
                <ul style="color:firebrick;">
                    <li>@item.customerId</li>
                    <li>@item.cAddress</li>
                    <li>@item.cPhoneNumber</li>
                 </ul>

            }
