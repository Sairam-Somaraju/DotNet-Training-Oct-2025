@model IEnumerable<First_MVC.Models.Department>
@{
    ViewBag.Title = "DepartmentList";
}

<h2>Department List</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Department ID</th>
            <th>Depatment Name</th>
         </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
             </tr>
        }
    </tbody>
</table>



