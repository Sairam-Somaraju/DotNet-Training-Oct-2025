@model Database_First.Models.Customer
@{
    ViewBag.Title = "CustomerOrder";
}

<style>
    p {
        margin: 6px 0;
        font-family: Arial, sans-serif;
    }
</style>

<h2>Customer Order with OrderID=10248</h2>

@if (Model != null)
{
    <p>Customer ID: @Model.CustomerID</p>
    <p>Company Name: @Model.CompanyName</p>
    <p>Contact Name: @Model.ContactName</p>
    <p>Country: @Model.Country</p> }
else
{
    <p>No ID Found</p>
}