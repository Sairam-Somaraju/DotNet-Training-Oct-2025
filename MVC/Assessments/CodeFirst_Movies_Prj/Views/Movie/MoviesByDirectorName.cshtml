@model IEnumerable<CodeFirst_Movies_Prj.Models.Movie>

@{
    ViewBag.Title = "MoviesByDirectorName";
}

<h2>Movies By Director: @ViewBag.DirectorName</h2>

@if (Model != null )
{
    foreach (var movie in Model)
    {
        <p>
            <b>Movie ID:</b> @movie.Mid <br />
            <b>Movie Name:</b> @movie.Moviename <br />
            <b>Date of Release:</b> @movie.DateofRelease.ToShortDateString() <br />
            <b>Director Name:</b> @movie.DirectorName
        </p>
        <hr />
    }
}
else
{
    <p>No movies found for this director.</p>
}


